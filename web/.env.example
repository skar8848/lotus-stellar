# Copy to .env.local (git-ignored). Everything here is optional.
#
# DEV-ONLY signer so signed flows can be tested without a browser wallet extension.
# WARNING: NEXT_PUBLIC_* variables are inlined into the client bundle. Use throwaway TESTNET keys
# only and never ship a build made with the dev signer enabled.
#
# NEXT_PUBLIC_DEV_SIGNER=1
# One secret:            NEXT_PUBLIC_DEV_SECRET=S...
# Or labelled accounts:  NEXT_PUBLIC_DEV_SECRET=maker=S...,taker=S...
#
# Optional: directory holding testnet.contract.json / testnet.classic.json / testnet.strategies.json
# LOTUS_DEPLOYMENTS_DIR=../deployments
